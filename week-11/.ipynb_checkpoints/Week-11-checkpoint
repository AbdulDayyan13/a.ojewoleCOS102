    "import pandas as pd\n",
    "from IPython.display import display\n",
    "\n",
    "# ==========================================\n",
    "# OOP LOGIC: Encapsulation & Getters\n",
    "# ==========================================\n",
    "\n",
    "class StudentRecord:\n",
    "    def __init__(self, matno, name, age, grade):\n",
    "        # Public variables\n",
    "        self.matno = matno\n",
    "        self.name = name\n",
    "        self.grade = grade\n",
    "        \n",
    "        # Private variables (Encapsulation)\n",
    "        self.__age = age\n",
    "        self.__error_message = f\"ERROR: Access Denied. {self.name} (Age: {self.__age}) is greater than 25.\"\n",
    "\n",
    "    # Getter method to securely evaluate age and return the category or encapsulated error\n",
    "    def get_category(self):\n",
    "        # Note: Using '<=' on the upper bounds so students who are exactly 18, 22, or 25 are not left out!\n",
    "        if 14 < self.__age <= 18:\n",
    "            return \"The_Pirates\"\n",
    "        elif 18 < self.__age <= 22:\n",
    "            return \"The_Yankees\"\n",
    "        elif 22 < self.__age <= 25:\n",
    "            return \"The_Bulls\"\n",
    "        elif self.__age > 25:\n",
    "            # Returning the private error message via the getter\n",
    "            return self.__error_message\n",
    "        else:\n",
    "            return \"Uncategorized\"\n",
    "\n",
    "    # Helper to return dictionary format for Pandas\n",
    "    def to_dict(self):\n",
    "        return {\"MatNo\": self.matno, \"Name\": self.name, \"Age\": self.__age, \"Grade\": self.grade}\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# MAIN EXECUTION SCRIPT\n",
    "# ==========================================\n",
    "\n",
    "# 1. Read the data\n",
    "df = pd.read_csv('SIS.csv')\n",
    "\n",
    "# Lists to hold the categorized data\n",
    "pirates_list = []\n",
    "yankees_list = []\n",
    "bulls_list = []\n",
    "error_logs = []\n",
    "\n",
    "# 2. Iterate through the dataframe and create Student objects\n",
    "for index, row in df.iterrows():\n",
    "    # Instantiate the object\n",
    "    student = StudentRecord(row['MatNo'], row['Name'], row['Age'], row['Grade'])\n",
    "    \n",
    "    # Use the getter method to fetch the category or error\n",
    "    result = student.get_category()\n",
    "    \n",
    "    # 3. Sort the students based on the getter's return value\n",
    "    if result == \"The_Pirates\":\n",
    "        pirates_list.append(student.to_dict())\n",
    "    elif result == \"The_Yankees\":\n",
    "        yankees_list.append(student.to_dict())\n",
    "    elif result == \"The_Bulls\":\n",
    "        bulls_list.append(student.to_dict())\n",
    "    elif \"ERROR\" in result:\n",
    "        error_logs.append(result)\n",
    "\n",
    "# 4. Convert lists back to DataFrames\n",
    "df_pirates = pd.DataFrame(pirates_list)\n",
    "df_yankees = pd.DataFrame(yankees_list)\n",
    "df_bulls = pd.DataFrame(bulls_list)\n",
    "\n",
    "# 5. Save them to .csv files\n",
    "df_pirates.to_csv('The_Pirates.csv', index=False)\n",
    "df_yankees.to_csv('The_Yankees.csv', index=False)\n",
    "df_bulls.to_csv('The_Bulls.csv', index=False)\n",
    "\n",
    "# 6. Display the DataFrames and Errors\n",
    "print(\"--- THE PIRATES (Ages 15 - 18) ---\")\n",
    "display(df_pirates)\n",
    "\n",
    "print(\"\\n--- THE YANKEES (Ages 19 - 22) ---\")\n",
    "display(df_yankees)\n",
    "\n",
    "print(\"\\n--- THE BULLS (Ages 23 - 25) ---\")\n",
    "display(df_bulls)\n",
    "\n",
    "print(\"\\n--- ENCAPSULATED ERROR MESSAGES (> 25) ---\")\n",
    "for error in error_logs:\n",
    "    print(error)"
   ]
  }
