    "import tkinter as tk\n",
    "from tkinter import ttk, messagebox\n",
    "\n",
    "# ==========================================\n",
    "# OOP LOGIC: Inheritance and Polymorphism\n",
    "# ==========================================\n",
    "\n",
    "# Parent Class\n",
    "class Zenith:\n",
    "    def __init__(self, name):\n",
    "        self.name = name\n",
    "\n",
    "    def mutual_services(self):\n",
    "        # Services shared between Retail and Commercial\n",
    "        return [\n",
    "            \"Lines of credit\", \n",
    "            \"Investment management and accounts\", \n",
    "            \"Insurance\"\n",
    "        ]\n",
    "\n",
    "    def unique_services(self):\n",
    "        # To be overridden by subclasses (Polymorphism)\n",
    "        return []\n",
    "\n",
    "    def display_services(self):\n",
    "        # Combines mutual and unique services\n",
    "        return self.mutual_services() + self.unique_services()\n",
    "\n",
    "\n",
    "# Child Class 1\n",
    "class RetailBanking(Zenith):\n",
    "    # Polymorphism: Overriding the unique_services method\n",
    "    def unique_services(self):\n",
    "        return [\n",
    "            \"Retirement and education accounts\",\n",
    "            \"Loans and mortgages\",\n",
    "            \"Checking and saving\"\n",
    "        ]\n",
    "\n",
    "# Child Class 2\n",
    "class GlobalBanking(Zenith):\n",
    "    # Polymorphism: Overriding BOTH methods because Global Banking \n",
    "    # does not share the mutual services of the other two divisions\n",
    "    def mutual_services(self):\n",
    "        return []\n",
    "\n",
    "    def unique_services(self):\n",
    "        return [\n",
    "            \"Multi-currency management services and products\",\n",
    "            \"Foreign currency accounts\",\n",
    "            \"Foreign currency credit cards\",\n",
    "            \"Transborder advisory services\",\n",
    "            \"Liquidity management\"\n",
    "        ]\n",
    "\n",
    "# Child Class 3\n",
    "class CommercialBanking(Zenith):\n",
    "    # Polymorphism: Overriding the unique_services method\n",
    "    def unique_services(self):\n",
    "        return [\n",
    "            \"Advisory services\"\n",
    "        ]\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# GUI APPLICATION LOGIC (Tkinter)\n",
    "# ==========================================\n",
    "\n",
    "def fetch_services():\n",
    "    emp_name = name_entry.get().strip()\n",
    "    division = division_combo.get()\n",
    "\n",
    "    # Input validation\n",
    "    if not emp_name:\n",
    "        messagebox.showerror(\"Input Error\", \"Please enter the employee's name.\")\n",
    "        return\n",
    "    if not division:\n",
    "        messagebox.showerror(\"Input Error\", \"Please select a banking division.\")\n",
    "        return\n",
    "\n",
    "    # Object Instantiation based on selected division\n",
    "    if division == \"Retail Banking\":\n",
    "        employee = RetailBanking(emp_name)\n",
    "    elif division == \"Global Banking\":\n",
    "        employee = GlobalBanking(emp_name)\n",
    "    elif division == \"Commercial Banking\":\n",
    "        employee = CommercialBanking(emp_name)\n",
    "\n",
    "    # Fetching services using the inherited/overridden methods\n",
    "    services = employee.display_services()\n",
    "\n",
    "    # Displaying the output in the text box\n",
    "    output_text.config(state=tk.NORMAL)\n",
    "    output_text.delete(1.0, tk.END)\n",
    "    \n",
    "    output_text.insert(tk.END, f\"Employee Name: {employee.name}\\n\")\n",
    "    output_text.insert(tk.END, f\"Division: {division}\\n\")\n",
    "    output_text.insert(tk.END, \"-\" * 40 + \"\\n\")\n",
    "    output_text.insert(tk.END, \"Authorized Services:\\n\\n\")\n",
    "    \n",
    "    for i, service in enumerate(services, start=1):\n",
    "        output_text.insert(tk.END, f\"{i}. {service}\\n\")\n",
    "        \n",
    "    output_text.config(state=tk.DISABLED)\n",
    "\n",
    "\n",
    "# --- UI Setup ---\n",
    "root = tk.Tk()\n",
    "root.title(\"Zenith Bank - Employee Portal\")\n",
    "root.geometry(\"450x450\")\n",
    "root.config(padx=20, pady=20)\n",
    "\n",
    "# Main Title\n",
    "title_label = tk.Label(root, text=\"Zenith Bank Division Lookup\", font=(\"Helvetica\", 14, \"bold\"))\n",
    "title_label.pack(pady=(0, 15))\n",
    "\n",
    "# Input Frame\n",
    "input_frame = tk.Frame(root)\n",
    "input_frame.pack(fill=tk.X)\n",
    "\n",
    "# Name Input\n",
    "tk.Label(input_frame, text=\"Employee Name:\", font=(\"Helvetica\", 10)).grid(row=0, column=0, sticky=\"w\", pady=5)\n",
    "name_entry = tk.Entry(input_frame, width=30)\n",
    "name_entry.grid(row=0, column=1, padx=10, pady=5)\n",
    "\n",
    "# Division Input\n",
    "tk.Label(input_frame, text=\"Division:\", font=(\"Helvetica\", 10)).grid(row=1, column=0, sticky=\"w\", pady=5)\n",
    "divisions = [\"Retail Banking\", \"Global Banking\", \"Commercial Banking\"]\n",
    "division_combo = ttk.Combobox(input_frame, values=divisions, state=\"readonly\", width=27)\n",
    "division_combo.grid(row=1, column=1, padx=10, pady=5)\n",
    "\n",
    "# Action Button\n",
    "submit_btn = tk.Button(root, text=\"Check Services\", bg=\"#1f4e79\", fg=\"white\", font=(\"Helvetica\", 10, \"bold\"), command=fetch_services)\n",
    "submit_btn.pack(pady=15)\n",
    "\n",
    "# Output Box\n",
    "output_text = tk.Text(root, height=12, width=50, bg=\"#f4f4f4\", font=(\"Helvetica\", 10))\n",
    "output_text.pack()\n",
    "output_text.config(state=tk.DISABLED) # Make it read-only by default\n",
    "\n",
    "# Run the application\n",
    "root.mainloop()"
   ]
  }
